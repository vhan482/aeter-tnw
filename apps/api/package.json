{
  "name": "@aeter/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "tsx --test --test-concurrency=1 src/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "bootstrap:leader": "tsx src/cli/bootstrap-leader.ts",
    "evidence:cleanup": "tsx src/cli/cleanup-evidence.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.7",
    "express": "^4.21.2",
    "pg": "^8.14.1",
    "zod": "^3.24.2",
    "argon2": "^0.45.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "multer": "2.5.0",
    "file-type": "22.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.3",
    "typescript": "~5.7.3",
    "supertest": "^7.1.3",
    "@types/supertest": "^6.0.2",
    "@types/multer": "2.3.0"
  }
}
