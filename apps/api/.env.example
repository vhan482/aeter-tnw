# Start with local PostgreSQL at 127.0.0.1:55432.
# URI-encode special characters in passwords.
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://aeter:replace-with-a-long-random-local-password@127.0.0.1:55432/aeter_tnw
# Browser origin must match exactly (including host and port). HTTPS required in production.
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173

# Private screenshot directory outside the public Nginx web root.
UPLOAD_DIR=/var/lib/aeter/uploads
