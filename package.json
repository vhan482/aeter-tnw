{
  "name": "aeter-tnw",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "yarn@4.11.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "yarn prepare:ocr && vite --host 127.0.0.1",
    "dev:web": "yarn prepare:ocr && vite --host 127.0.0.1",
    "dev:api": "yarn workspace @aeter/api dev",
    "build": "yarn build:web && yarn workspace @aeter/api build",
    "build:web": "tsc -b && yarn prepare:ocr && vite build",
    "typecheck": "tsc -b && yarn workspace @aeter/api typecheck",
    "test": "yarn workspace @aeter/api test",
    "preview": "vite preview --host 127.0.0.1",
    "db:up": "docker compose --env-file infra/.env -f infra/compose.dev.yaml up -d",
    "db:down": "docker compose --env-file infra/.env -f infra/compose.dev.yaml down",
    "db:generate": "yarn workspace @aeter/api db:generate",
    "db:migrate": "yarn workspace @aeter/api db:migrate",
    "prepare:ocr": "node scripts/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "7.0.0",
    "@tesseract.js-data/eng": "1.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.7.3",
    "vite": "^6.0.0"
  }
}
